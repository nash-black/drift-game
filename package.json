{
  "name": "turbo-horizon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit",
    "desktop": "electron .",
    "build:desktop": "npm run build && electron-builder",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^4.0.0",
    "electron": "^31.7.4",
    "electron-builder": "^25.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.nashblack.turbohorizon",
    "productName": "Turbo Horizon",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "Turbo-Horizon-${version}-Setup.exe"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Turbo-Horizon-${version}.dmg"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Turbo-Horizon-${version}.AppImage"
    }
  }
}
